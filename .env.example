# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-here

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/polymaxii"

# Redis
REDIS_URL="redis://localhost:6379"

# Binance API (for live trading — leave blank for paper trading)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Use testnet for development: https://testnet.binance.vision
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Stripe (Apple Pay deposits)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Bitcoin Withdrawals
# HD wallet mnemonic — KEEP SECRET, BACK UP SECURELY
BTC_WALLET_MNEMONIC="word1 word2 word3 ... word12"
# Use mainnet or testnet
BTC_NETWORK=mainnet
# Minimum withdrawal in satoshis (default: 50000 = 0.0005 BTC)
BTC_MIN_WITHDRAWAL_SATS=50000
# Fee rate in sat/vbyte
BTC_FEE_RATE=10
# Blockstream API for broadcasting transactions
BLOCKSTREAM_API_URL=https://blockstream.info/api

# ML Prediction Service (optional — uses built-in TS engine if not set)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_ENABLED=false

# Trading Configuration (defaults — overridden per-user in DB)
DEFAULT_MIN_CONFIDENCE=65
DEFAULT_MAX_POSITION_SIZE_PERCENT=5
DEFAULT_STOP_LOSS_PERCENT=2
DEFAULT_TAKE_PROFIT_PERCENT=4
DEFAULT_MAX_CONCURRENT_TRADES=3

# Deposit limits (USD cents)
MIN_DEPOSIT_CENTS=1000
MAX_DEPOSIT_CENTS=1000000

# Security
ENCRYPTION_KEY=32-byte-hex-key-for-encrypting-api-keys
